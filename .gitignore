# ── 运行时产物 ──
# data/ 含 app.db（课件正文/章节/幻灯片/讲解稿）与生成的音频、视频、截图
data/
logs/
work/

# ── Python 缓存 ──
__pycache__/
*.py[cod]
*$py.class

# ── 测试缓存 ──
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── 虚拟环境 ──
.venv/
venv/
env/
ENV/

# ── 密钥与环境变量 ──
.env
.env.*
!.env.example
*.pem
*.key

# ── 编辑器与系统文件 ──
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ── 导出产物（防止误提交大文件）──
*.pptx
*.mp4
*.wav
*.mp3
